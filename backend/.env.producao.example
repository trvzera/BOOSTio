# Exemplo para as variáveis da hospedagem. Não coloque credenciais reais neste arquivo.
APP_ENV=producao
FRONTEND_URL=https://boostio.com.br
API_PUBLIC_URL=https://api.boostio.com.br
CORS_ORIGINS=https://boostio.com.br
SESSION_COOKIE_SAMESITE=Lax

# Ajuste estes números após conferir os cabeçalhos enviados pela hospedagem.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_PROTO_HOPS=0

# Preencha na hospedagem com valores reais; use armazenamento persistente para o banco.
URL_DATABASE=
RATELIMIT_STORAGE_URI=
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
