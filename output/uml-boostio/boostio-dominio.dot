digraph BOOSTio {
graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.55", nodesep="0.42", ranksep="1.5 equally", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=30, fontcolor="#0056B3", labelloc=t, label="BOOSTio — Diagrama de classes do domínio\n ", compound=true, ordering=out];
node [shape=plain, fontname="Arial", margin=0];
edge [fontname="Arial", fontsize=13, color="#718096", penwidth=1.15, arrowsize=0.85, labeldistance=1.7, labelangle=25];
ModeloBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#77869B" BGCOLOR="white" RULES="ROWS"><TR><TD BGCOLOR="#EFF6FF"><FONT COLOR="#0056B3" POINT-SIZE="12">«abstract»</FONT></TD></TR><TR><TD PORT="title" BGCOLOR="#EFF6FF" CELLPADDING="10"><FONT COLOR="#0056B3" POINT-SIZE="19"><B><I>ModeloBase</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="14">id: Integer<BR ALIGN="LEFT"/>criado_em: DateTime<BR ALIGN="LEFT"/>atualizado_em: DateTime<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="14">salvar()<BR ALIGN="LEFT"/>deletar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
