nota_estado [shape=note, color="#B8C8DD", fillcolor="#F8FAFD", style=filled, fontname="Arial", fontsize=14, margin="0.18", label="estado armazena título, descrição,\lvisibilidade, tranca, orçamento, componentes e\lquantidades; são dados JSON, não colunas\lindividuais. Pode existir sem uma Build\loriginal.\l"];
BuildSalva -> nota_estado [dir=none, style=dashed, color="#A6B3C4", constraint=false];
nota_limite [shape=note, color="#B8C8DD", fillcolor="#F8FAFD", style=filled, fontname="Arial", fontsize=14, margin="0.18", label="limite de negócio: três configurações salvas\lpor conta\l"];
BuildSalva -> nota_limite [dir=none, style=dashed, color="#A6B3C4", constraint=false];
nota_quantidades [shape=note, color="#B8C8DD", fillcolor="#F8FAFD", style=filled, fontname="Arial", fontsize=14, margin="0.18", label="Em Build, quantidades representam unidades do\lmodelo referenciado. Em BuildSalva, o JSON\ltambém permite múltiplos modelos de RAM,\larmazenamento e fans.\l"];
Build -> nota_quantidades [dir=none, style=dashed, color="#A6B3C4", constraint=false];
{rank=same; Build; BuildSalva; nota_estado; nota_limite; nota_quantidades;}
Periferico -> Build [style=invis, weight=15, minlen=2];
Monitor -> Build [style=invis, weight=1];
Usuario -> Build [style=invis, weight=1];
}