# Copie para .env.production na VPS. Nunca versione o arquivo preenchido.
FRONTEND_URL=https://boostio.com.br
API_PUBLIC_URL=https://api.boostio.com.br
CORS_ORIGINS=https://boostio.com.br
SESSION_COOKIE_SAMESITE=Lax
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# A senha na URL_DATABASE deve ser codificada para URL quando tiver caracteres especiais.
MYSQL_DATABASE=boostio
MYSQL_USER=boostio
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
URL_DATABASE=mysql+pymysql://boostio:SENHA_CODIFICADA@db:3306/boostio?charset=utf8mb4

SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=no-reply@boostio.com.br
MAIL_PASSWORD=

# Mercado Livre: OAuth no backend (nunca preencher no Git).
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_CONTA_ID=

# Chave Fernet das credenciais no banco; gerar uma vez e manter fora do Git.
INTEGRACOES_TOKEN_CHAVE=

# Deve ser idêntica à URI cadastrada no aplicativo Mercado Livre.
MERCADO_LIVRE_REDIRECT_URI=https://api.boostio.com.br/auth/mercadolivre/callback

# Icecat opcional: usado ao importar anúncios desconhecidos com --permitir-novos.
ICECAT_USUARIO=
ICECAT_SENHA=
ICECAT_INDICE=
ICECAT_PASTA_FICHAS=/dados/icecat/fichas

# Consulta técnica opcional em sites oficiais de fabricantes.
FABRICANTES_HABILITADOS=false
FABRICANTES_CACHE=/dados/fabricantes/cache

# Shopee (API de Afiliados): obrigatórias para os comandos shopee-* e para tarefas da fila.
# Nunca versionar valores reais.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Segundos entre requisições à Shopee (mínimo 1).
SHOPEE_INTERVALO_REQUISICOES=1
